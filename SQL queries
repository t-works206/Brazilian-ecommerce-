SELECT
    order_unique_id,
    customer__id,
    customer_city,
    customer_state,
    seller_state,
    seller_id,
    product_category_name,

    TIMESTAMPDIFF(HOUR, order_approved_at, order_delivered_carrier_date) AS approval_to_carrier,

    TIMESTAMPDIFF(HOUR, order_delivered_carrier_date, order_delivered_customer_date) AS carrier_to_customer,

    TIMESTAMPDIFF(DAY, order_estimated_delivery_date, order_delivered_customer_date) AS delay_days,
    
    TIMESTAMPDIFF(DAY, order_delivered_customer_date, order_estimated_delivery_date) AS advanced_days,

    (product_length_cm * product_width_cm * product_height_cm) AS product_volume

FROM brazilian;





SELECT
customer_unique_id,
customer_id,
payment_type,
product_category_name,
day_of_purchase,
year_of_purchase,
seller_city,
customer_city,
customer_state,

(payment_value - (freight_value  + price)) AS profit

sum(payment_value) AS revenue

FROM brazilian
ORDER BY profit desc;










WITH city_metrics AS (
    SELECT
        seller_city,
        COUNT(order_id) AS total_orders,
        AVG(TIMESTAMPDIFF(DAY, order_approved_at, order_delivered_customer_date)) AS avg_delivery_time
    FROM brazilian
    WHERE order_approved_at IS NOT NULL
      AND order_delivered_customer_date IS NOT NULL
    GROUP BY seller_city
    HAVING COUNT(order_id) > 30
),

ranked AS (
    SELECT
        seller_city,
        total_orders,
        avg_delivery_time,

        ROW_NUMBER() OVER (ORDER BY avg_delivery_time) AS rnk,
        COUNT(*) OVER () AS total_rows

    FROM city_metrics
)

SELECT
    seller_city,
    total_orders,
    avg_delivery_time,

    CASE
        WHEN rnk <= total_rows * 0.33 THEN 'Good'
        WHEN rnk <= total_rows * 0.66 THEN 'Average'
        ELSE 'Bad'
    END AS performance_segment

FROM ranked;









